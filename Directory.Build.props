<Project>
  <PropertyGroup>
    <!-- Any compiler or analyzer warning fails the build -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Dalamud.NET.Sdk already does this for the plugin; keep the other projects reproducible too -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
