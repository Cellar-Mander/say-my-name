root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.cs]
# Allman braces, each else/catch/finally on its own line
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = false

csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
dotnet_style_object_initializer = false

# Naming, enforced by dotnet format in CI: private instance fields camelCase;
# private statics, consts and events PascalCase, events prefixed On
dotnet_naming_symbols.instance_fields.applicable_kinds = field
dotnet_naming_symbols.instance_fields.applicable_accessibilities = private
dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.applicable_accessibilities = private
dotnet_naming_symbols.static_fields.required_modifiers = static
dotnet_naming_symbols.const_fields.applicable_kinds = field
dotnet_naming_symbols.const_fields.applicable_accessibilities = private
dotnet_naming_symbols.const_fields.required_modifiers = const
dotnet_naming_symbols.events.applicable_kinds = event
dotnet_naming_symbols.events.applicable_accessibilities = *

dotnet_naming_style.camel.capitalization = camel_case
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_style.on_pascal.capitalization = pascal_case
dotnet_naming_style.on_pascal.required_prefix = On

# More specific symbol groups first: a const or static field is also a private field
dotnet_naming_rule.const_fields_pascal.symbols = const_fields
dotnet_naming_rule.const_fields_pascal.style = pascal
dotnet_naming_rule.const_fields_pascal.severity = warning
dotnet_naming_rule.static_fields_pascal.symbols = static_fields
dotnet_naming_rule.static_fields_pascal.style = pascal
dotnet_naming_rule.static_fields_pascal.severity = warning
dotnet_naming_rule.instance_fields_camel.symbols = instance_fields
dotnet_naming_rule.instance_fields_camel.style = camel
dotnet_naming_rule.instance_fields_camel.severity = warning
dotnet_naming_rule.events_on_pascal.symbols = events
dotnet_naming_rule.events_on_pascal.style = on_pascal
dotnet_naming_rule.events_on_pascal.severity = warning
