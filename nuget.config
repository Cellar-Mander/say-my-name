<?xml version="1.0" encoding="utf-8"?>
<!-- Buildingway.Tools (dotnet buildingway) comes from GitHub Packages, which needs a token even
     for public packages; everything else from nuget.org. See "Prerequisites" in CONTRIBUTING.md. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="buildingway" value="https://nuget.pkg.github.com/Cellar-Mander/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="buildingway">
      <package pattern="Buildingway.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
