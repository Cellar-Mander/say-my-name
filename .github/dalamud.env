# The Dalamud CI builds against, for PR builds and releases. Pinned so a release builds against
# the Dalamud it was tested with, not whatever latest.zip is when the tag is pushed. To move the
# pin, take the commit that promoted the new version in
# https://github.com/goatcorp/dalamud-distrib/commits/main/latest.zip and the SHA-256 of its
# latest.zip; match the Dalamud you test in-game with.
DALAMUD_VERSION=15.0.3.9
DALAMUD_COMMIT=261006903b8fd45513910a5d8a072bafe15e7f28
DALAMUD_SHA256=3e11e262426747b939bd8e1164a0f7d18bfda2dcc35b3f3ee7ee9fc7df78d2d9
