#!/usr/bin/env bash
# Release steps that need no judgement. See .github/workflows/release.yml for what happens once
# the release-prep PR is merged and the merge commit is tagged.
set -euo pipefail

top=$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)
csproj=SayMyName/SayMyName.csproj
repo=$(sed -n 's:.*<RepoUrl>https\://github.com/\(.*\)</RepoUrl>.*:\1:p' "$top/$csproj")
# The plugin's code; a change here is user-facing unless shown otherwise. The trailing slashes
# keep SayMyName.Core.Tests out.
plugin_paths=(SayMyName/ SayMyName.Core/)

# The Dalamud local builds use, as in CONTRIBUTING.md's table, and the one CI builds against
if [[ -n ${DALAMUD_HOME:-} ]]; then
    dalamud_dir=$DALAMUD_HOME
elif [[ -n ${APPDATA:-} ]] && command -v cygpath >/dev/null; then
    dalamud_dir=$(cygpath -u "$APPDATA")/XIVLauncher/addon/Hooks/dev
elif [[ $(uname) == Darwin ]]; then
    dalamud_dir="$HOME/Library/Application Support/XIV on Mac/dalamud/Hooks/dev"
else
    dalamud_dir=$HOME/.xlcore/dalamud/Hooks/dev
fi
pin_file=.github/dalamud.env

usage() {
    cat >&2 <<EOF
Usage: scripts/release prepare <version>   e.g. 0.1.2.0
       scripts/release publish <version> [--testing]
       scripts/release verify <version>|<version>-rc<n>

prepare: from origin/main, make branch release-prep/v<version> that sets <Version> and moves the
CHANGELOG's Unreleased entries under a dated heading; build, test, push and open the PR. When
main's <Version> was never released as stable (it went out only as a testing build, which
Dalamud won't update to another build of), its dated section moves to <version> instead, taking
any Unreleased entries with it. The PR lists the changes merged since the last release, flagging
plugin code changes that touched no CHANGELOG entry.

publish: run the Release workflow on main, which tags and publishes main's <Version> (it must be
<version>): v<version> as a stable release, or with --testing v<version>-rc1 as a
testing build, offered only to installs that receive testing versions. A testing build is
refused when <version> already has one: prepare the next version first.

verify: check that the published release is what installs get: the tag is on main at that
version, the GitHub release has the zip, the zip's manifest has the version, and the live
repo.json on main points at it. For a testing build (<version>-rc<n>), the release is a prerelease
and repo.json's testing fields point at it while its stable fields don't. Exits 1 if any check
fails.
EOF
    exit 2
}

die() { echo "$*" >&2; exit 1; }

csproj_version() { sed -n 's:.*<Version>\(.*\)</Version>.*:\1:p'; }

# A note when the launcher has updated the local Dalamud past the one CI is pinned to, so
# releases still build against an older one than you test with in-game
dalamud_note() {
    local pinned local_version
    pinned=$(sed -n 's/^DALAMUD_VERSION=//p' "$top/$pin_file" 2>/dev/null)
    [[ -n $pinned ]] || return 0
    local_version=$(grep -o '"Dalamud/[^"]*"' "$dalamud_dir/Dalamud.deps.json" 2>/dev/null |
        head -1 | sed 's:"Dalamud/\(.*\)":\1:')
    if [[ -z $local_version ]]; then
        echo "⚠ Couldn't read the local Dalamud version from $dalamud_dir/Dalamud.deps.json; CI builds against $pinned."
    elif [[ $local_version != "$pinned" ]]; then
        echo "⚠ Local Dalamud is $local_version but CI builds against $pinned. If you've tested with $local_version, move the pin in $pin_file."
    fi
}

# One line per change on main since $1: number, title and a flag when it changed plugin code
# without touching the CHANGELOG
changes_since() {
    local c subject num title flag
    while IFS=$'\t' read -r c subject; do
        if [[ $subject =~ ^Merge\ pull\ request\ \#([0-9]+) ]]; then
            num=${BASH_REMATCH[1]}
            title=$(git -C "$top" log -1 --format=%b "$c" | head -1)
        elif [[ $subject =~ ^(.*)\ \(\#([0-9]+)\)$ ]]; then
            title=${BASH_REMATCH[1]} num=${BASH_REMATCH[2]}
        else
            title=$subject num=
        fi
        flag=
        if ! git -C "$top" diff --quiet "$c^" "$c" -- "${plugin_paths[@]}" &&
            git -C "$top" diff --quiet "$c^" "$c" -- CHANGELOG.md; then
            flag=" ⚠ plugin code changed, no CHANGELOG entry"
        fi
        echo "- ${num:+#$num }$title$flag"
    done < <(git -C "$top" log --first-parent --format=$'%H\t%s' "$1..origin/main")
}

# CHANGELOG.md on stdin with the section after Unreleased, unreleased version $1's, renamed to
# heading $2 and the Unreleased entries merged into it, each under its ### heading
reversion_changelog() {
    awk -v old="## $1 - " -v heading="$2" '
        function add(text, line) { return text == "" ? line : line == "" ? text : text "\n" line }
        # Its entries, then the ones merged since it was dated
        function block(key,   text) {
            text = add(rel[key], new[key])
            if (key != "") printf "\n%s\n", key
            if (text != "") printf "\n%s\n", text
        }
        function merged(   i, key, kinds, done) {
            print heading
            block("")
            # Keep a Changelog order first, then any other headings as they came
            split("Added Changed Deprecated Removed Fixed Security", kinds, " ")
            for (i = 1; i <= 6; i++) {
                key = "### " kinds[i]
                if (key in seen) { block(key); done[key] = 1 }
            }
            for (i = 1; i <= n; i++) if (!(order[i] in done)) block(order[i])
        }
        /^## / {
            if (state == "old") { merged(); print ""; state = "after" }
            else if (state == "unreleased" && index($0, old) == 1) { state = "old"; key = ""; next }
            else if ($0 == "## Unreleased") { print; print ""; state = "unreleased"; key = ""; next }
        }
        state == "unreleased" || state == "old" {
            if (/^### /) key = $0
            else if (NF) {
                if (key != "" && !(key in seen)) { seen[key] = 1; order[++n] = key }
                if (state == "old") rel[key] = add(rel[key], $0); else new[key] = add(new[key], $0)
            }
            next
        }
        { print }
        END { if (state == "old") merged() }
    '
}

prepare() {
    [[ $# == 1 ]] || usage
    local version=$1
    [[ $version =~ ^[0-9]+(\.[0-9]+){3}$ ]] || die "Version must be four numbers, e.g. 0.1.2.0"
    local tag=v$version branch=release-prep/v$version

    [[ -z $(git -C "$top" status --porcelain) ]] || die "Commit or set aside your changes first."
    git -C "$top" fetch -q --tags origin main

    local current last
    current=$(git -C "$top" show "origin/main:$csproj" | csproj_version)
    [[ $version != "$current" &&
        $(printf '%s\n' "$current" "$version" | sort -V | tail -1) == "$version" ]] ||
        die "$version isn't above the version on main, $current."
    ! git -C "$top" rev-parse -q --verify "refs/tags/$tag" >/dev/null || die "Tag $tag already exists."
    # Test tags (v…-test1) are prereleases, not the last release
    last=$(git -C "$top" describe --tags --abbrev=0 --match 'v*' --exclude 'v*-*' origin/main)

    # A dated section for a <Version> never released as stable (only as testing builds, or not
    # at all) moves to the new version, as each testing build needs a higher version than the last
    local reversion='' heading
    heading="## $version - $(date +%F)"
    if ! git -C "$top" rev-parse -q --verify "refs/tags/v$current" >/dev/null &&
        git -C "$top" show origin/main:CHANGELOG.md |
        awk -v h="## $current - " \
            '/^## /{if (u && !seen) {found = index($0, h) == 1; seen = 1} u = ($0 == "## Unreleased")} END {exit !found}'; then
        reversion=yes
    else
        # Entries are the non-blank lines between "## Unreleased" and the next version heading
        git -C "$top" show origin/main:CHANGELOG.md |
            awk '/^## /{u = ($0 == "## Unreleased"); next} u && NF {found=1} END {exit !found}' ||
            die "CHANGELOG.md has no Unreleased entries to release."
    fi

    git -C "$top" switch -q -c "$branch" origin/main
    sed -i "s:<Version>$current</Version>:<Version>$version</Version>:" "$top/$csproj"
    if [[ -n $reversion ]]; then
        reversion_changelog "$current" "$heading" <"$top/CHANGELOG.md" >"$top/CHANGELOG.md.tmp"
    else
        awk -v heading="$heading" \
            '{print} $0 == "## Unreleased" {print ""; print heading}' \
            "$top/CHANGELOG.md" >"$top/CHANGELOG.md.tmp"
    fi
    mv "$top/CHANGELOG.md.tmp" "$top/CHANGELOG.md"

    local note
    note=$(dalamud_note)
    [[ -z $note ]] || echo "$note" >&2

    # The release workflow refuses a tag that doesn't match the version DalamudPackager writes
    dotnet build "$top/SayMyName.slnx" -c Release --nologo -v q
    local built
    built=$(sed -n 's/.*"AssemblyVersion": *"\([^"]*\)".*/\1/p' \
        "$top/SayMyName/bin/x64/Release/SayMyName/SayMyName.json")
    [[ $built == "$version" ]] || die "The built manifest says $built, not $version."
    dotnet test "$top/SayMyName.Core.Tests" -c Release --nologo -v q

    local changes
    changes=$(changes_since "$last")
    echo "Changes since $last:"
    echo "$changes"

    local dated="dates the CHANGELOG section"
    [[ -z $reversion ]] ||
        dated="moves the CHANGELOG section of $current, never released as stable, to $version with the Unreleased entries"
    git -C "$top" commit -q -m "Prepare $version" -- "$csproj" CHANGELOG.md
    git -C "$top" push -q -u origin "$branch"
    gh pr create --base main --head "$branch" --title "Prepare $version" --body "$(cat <<EOF
Sets \`<Version>\` to $version and $dated. Made by \`scripts/release prepare\`, which built the plugin and ran the tests.

Before merging, check that every user-facing change below has a CHANGELOG entry. ⚠ marks a change to plugin code that touched no CHANGELOG entry.

Changes since $last:
$changes
${note:+
$note
}
After merging, publish it with \`scripts/release publish $version --testing\` for a testing build, or \`scripts/release publish $version\` for the stable release.
EOF
)"
}

publish() {
    local version=${1:-} channel=stable
    if [[ $# == 2 && $2 == --testing ]]; then channel=testing; else [[ $# == 1 ]] || usage; fi
    [[ $version =~ ^[0-9]+(\.[0-9]+){3}$ ]] || die "Version must be four numbers, e.g. 0.1.2.0"

    # The workflow publishes main's <Version>; naming it here catches publishing the wrong one
    git -C "$top" fetch -q origin main
    local current
    current=$(git -C "$top" show "origin/main:$csproj" | csproj_version)
    [[ $current == "$version" ]] ||
        die "<Version> on main is $current, not $version. Run prepare $version and merge its PR first."
    # As the workflow's tag job: installs that have a testing build only update to a higher version
    if [[ $channel == testing ]]; then
        local rc
        rc=$(git -C "$top" ls-remote --tags --refs origin "refs/tags/v$version-rc*" |
            sed 's:.*refs/tags/::' | sort -V | tail -1)
        [[ -z $rc ]] ||
            die "$rc is already out for testing, and installs that have it won't update to another build of $version. Run prepare ${version%.*}.$((${version##*.} + 1)) and merge its PR first."
    fi

    gh workflow run release.yml -R "$repo" --ref main -f channel="$channel"
    echo "Started the Release workflow for the $channel channel. Its summary names the tag; follow it with:"
    echo "  gh run watch -R $repo \$(gh run list -R $repo --workflow release.yml -L 1 --json databaseId --jq '.[].databaseId')"
}

verify() {
    [[ $# == 1 ]] || usage
    [[ $1 =~ ^[0-9]+(\.[0-9]+){3}(-rc[0-9]+)?$ ]] || die "Give a version, e.g. 0.1.2.0, or a testing build, e.g. 0.1.2.0-rc1"
    local version=${1%%-*} tag=v$1 testing='' failed=0
    [[ $1 == "$version" ]] || testing=yes
    check() {
        if [[ $2 == "$3" ]]; then echo "✓ $1"; else echo "✗ $1: expected ${3:-nothing}, got ${2:-nothing}"; failed=1; fi
    }
    # Fields of the one-entry, one-field-per-line JSON that repo.json and the manifest use
    field() { sed -n "s/.*\"$1\": *\"\([^\"]*\)\".*/\1/p" <<<"$2"; }
    number() { sed -n "s/.*\"$1\": *\([0-9]*\).*/\1/p" <<<"$2"; }

    git -C "$top" fetch -q --tags origin main

    local tagged=
    if git -C "$top" rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
        git -C "$top" merge-base --is-ancestor "$tag" origin/main && tagged=yes
        check "$tag is on main" "$tagged" yes
        check "<Version> at $tag" "$(git -C "$top" show "$tag:$csproj" | csproj_version)" "$version"
    else
        check "tag $tag" "" "pushed to origin"
    fi

    check "GitHub release $tag" \
        "$(gh release view "$tag" -R "$repo" --json isPrerelease,isDraft,assets \
            --jq 'if .isDraft then "draft"
                  else (if .isPrerelease then "prerelease " else "" end) + ([.assets[].name] | join(",")) end' \
            2>/dev/null)" "${testing:+prerelease }SayMyName.zip"

    local url=https://github.com/$repo/releases/download/$tag/SayMyName.zip
    local zip
    zip=$(mktemp)
    # shellcheck disable=SC2064 # expand now: zip is local and gone when the trap runs
    trap "rm -f '$zip'" EXIT
    if curl -sfL -o "$zip" "$url"; then
        check "version in the zip's manifest" \
            "$(field AssemblyVersion "$(unzip -p "$zip" SayMyName.json 2>/dev/null)")" "$version"
    else
        check "download $url" "" "the zip"
    fi

    # What /xlsettings fetches. raw.githubusercontent.com caches for a few minutes, so a repo.json
    # PR merged just now can still show the old version.
    local json link
    json=$(curl -sfL "https://raw.githubusercontent.com/$repo/main/repo.json" || true)
    if [[ -n $testing ]]; then
        # Dalamud offers the testing build only above the stable version and at the game's API level
        check "repo.json TestingAssemblyVersion" "$(field TestingAssemblyVersion "$json")" "$version"
        check "repo.json DownloadLinkTesting" "$(field DownloadLinkTesting "$json")" "$url"
        check "repo.json TestingDalamudApiLevel matches DalamudApiLevel" \
            "$(number TestingDalamudApiLevel "$json")" "$(number DalamudApiLevel "$json")"
        local stable below=''
        stable=$(field AssemblyVersion "$json")
        [[ $stable != "$version" && $(printf '%s\n' "$stable" "$version" | sort -V | tail -1) == "$version" ]] &&
            below=yes
        check "repo.json AssemblyVersion ($stable) is below $version" "$below" yes
        for link in DownloadLinkInstall DownloadLinkUpdate; do
            check "repo.json $link doesn't point at $tag" "$([[ $(field "$link" "$json") != "$url" ]] && echo yes)" yes
        done
    else
        check "repo.json AssemblyVersion" "$(field AssemblyVersion "$json")" "$version"
        for link in DownloadLinkInstall DownloadLinkUpdate DownloadLinkTesting; do
            check "repo.json $link" "$(field "$link" "$json")" "$url"
        done
        # A testing version left behind would keep opted-in installs on the build being released
        check "repo.json has no TestingAssemblyVersion" "$(field TestingAssemblyVersion "$json")" ""
        check "repo.json IconUrl" "$(field IconUrl "$json")" \
            "https://raw.githubusercontent.com/$repo/$tag/SayMyName/images/icon.png"
    fi
    check "icon downloads" "$(curl -sfIL -o /dev/null -w '%{http_code}' "$(field IconUrl "$json")" || true)" 200

    if ((failed)); then
        local pr
        pr=$(gh pr list -R "$repo" --head release/repo-json --state open --json url --jq '.[].url')
        [[ -z $pr ]] || echo "The repo.json PR isn't merged yet: $pr"
        return 1
    fi
}

case ${1:-} in
    prepare) shift; prepare "$@" ;;
    publish) shift; publish "$@" ;;
    verify) shift; verify "$@" ;;
    *) usage ;;
esac
